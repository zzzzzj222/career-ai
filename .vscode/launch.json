{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "启动 Day12 文章 API",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "week02.day12.article_api.main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "cwd": "${workspaceFolder}",
      "subProcess": true,
      "justMyCode": false
    },
    {
      "name": "启动 FastAPI 演示项目",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "day11:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "cwd": "${workspaceFolder}\\week02\\day11",
      "subProcess": true,
      "justMyCode": false
    }
  ]
}
